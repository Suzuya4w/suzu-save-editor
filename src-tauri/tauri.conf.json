{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Suzu Save Editor",
  "version": "1.0.0",
  "identifier": "com.suzu.saveeditor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
          {
            "title": "Suzu Save Editor",
            "width": 1280,
            "height": 800,
            "minWidth": 1024,
            "minHeight": 700,
            "resizable": true,
            "visible": true,
            "label": "main"
          }
        ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "schemes": ["suzu"]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEzRDcwN0ZEQzMwRjczNEUKUldST2N3L0QvUWZYRTQ0SGRNd29nTzY4Y0ViTGRZVVJkRlpkUUppaFQrVEIrTlFDVnd6V0JsckUK",
      "endpoints": [
        "https://github.com/Suzuya4w/suzu-save-editor/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}