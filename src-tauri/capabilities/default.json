{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "deep-link:default",
    "opener:default",
    "opener:allow-open-path",
    "dialog:default",
    "fs:default",
    "fs:allow-copy-file",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-app-write",
    "fs:allow-app-write-recursive",
    "http:default",
    "updater:default",
    "process:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://**" }, { "url": "http://**" }, { "url": "http://*/**" }, { "url": "https://*/**" }, { "url": "http://*:*/**" }, { "url": "https://*:*/**" }, { "url": "http://localhost:1420/*" }]
    }
  ]
}